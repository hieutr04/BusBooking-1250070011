@model List<BusRoute>
@{
    ViewData["Title"]="Đặt vé xe khách trực tuyến";
    var featured=Model.Select(route=>(Route:route,Photo:PhotoCatalog.Destination(route.Destination)))
        .OrderBy(item=>item.Photo==PhotoCatalog.Neutral)
        .DistinctBy(item=>item.Photo.Key)
        .Take(3);
}
<section class="booking-hero buscenter-hero" aria-labelledby="home-hero-title"><div class="hero-text"><h1 id="home-hero-title">Chọn ghế cho<br/><em>chuyến đi của bạn.</em></h1><p>Tìm chuyến theo ngày đi, xem ghế trống theo thời gian thực và nhận mã vé trong tài khoản.</p><div class="hero-highlights"><span>@await Html.PartialAsync("_Icon","seat") Chọn đúng ghế</span><span>@await Html.PartialAsync("_Icon","clock") Giữ chỗ 5 phút</span></div><a class="hero-search-link" href="#search-title">Đến bộ tìm chuyến @await Html.PartialAsync("_Icon","arrow")</a></div><div class="hero-art"><figure class="hero-photo">@await Html.PartialAsync("_Photo",new PhotoDisplay(PhotoCatalog.CoachHero,false))</figure><div class="hero-image-label"><span aria-hidden="true"></span>Sơ đồ ghế cập nhật trực tiếp</div></div></section>
<section class="search-panel panel" aria-labelledby="search-title"><div class="search-panel-title"><span class="search-symbol">@await Html.PartialAsync("_Icon","bus")</span><div><h2 id="search-title">Tìm chuyến xe của bạn</h2><p>Chọn điểm đi, điểm đến và ngày khởi hành.</p></div></div>
<form asp-controller="Trips" asp-action="Index" method="get" class="search-form"><div><label for="origin">Nơi đi</label><select id="origin" name="origin"><option value="">Tất cả điểm đi</option>@foreach(var x in ProvinceSearch.Options(Model.SelectMany(x=>new[]{x.Origin,x.Destination}))){<option>@x</option>}</select></div><div><label for="destination">Nơi đến</label><select id="destination" name="destination"><option value="">Tất cả điểm đến</option>@foreach(var x in ProvinceSearch.Options(Model.SelectMany(x=>new[]{x.Origin,x.Destination}))){<option>@x</option>}</select></div><div><label for="date">Ngày khởi hành</label><input id="date" name="date" type="date" value="@DateTime.UtcNow.AddHours(7).AddDays(1).ToString("yyyy-MM-dd")" required/></div><button class="btn btn-primary" type="submit">@await Html.PartialAsync("_Icon","search") Tìm chuyến</button>
    <partial name="_TripSearchQuickActions"/>
</form>
<div class="search-meta"><span>Đặt vé trực tuyến · Thanh toán QR</span></div></section>
<section class="service-strip" aria-label="Quy trình đặt vé"><div>@await Html.PartialAsync("_Icon","search")<span><strong>Tìm đúng hành trình</strong><small>Theo tuyến và ngày đi</small></span></div><div>@await Html.PartialAsync("_Icon","seat")<span><strong>Sơ đồ ghế trực quan</strong><small>Xem tình trạng ghế mới nhất</small></span></div><div>@await Html.PartialAsync("_Icon","ticket")<span><strong>Mã vé trong tài khoản</strong><small>Theo dõi đặt vé & thanh toán</small></span></div></section>
<section class="section-block transit-home-routes"><div class="section-heading"><div><h2>Các tuyến đang hoạt động</h2></div><a class="text-action" asp-controller="Trips" asp-action="Index">Tìm tất cả chuyến @await Html.PartialAsync("_Icon","arrow")</a></div>
@if(Model.Count==0){<div class="empty panel"><h3>Chưa có tuyến đang hoạt động</h3><p>Vui lòng quay lại sau khi lịch trình được cập nhật.</p></div>}
<div class="route-grid">@foreach(var (item,photo) in featured){
    <article class="route-card"><a class="route-main" asp-controller="Trips" asp-action="Index" asp-route-origin="@item.Origin" asp-route-destination="@item.Destination"><div class="route-art"><img src="@Url.Content(photo.Path)" alt="@photo.Alt" width="@photo.Width" height="@photo.Height" style="object-position:@photo.Position" loading="lazy" decoding="async" data-image-fallback="@Url.Content("~/images/landscape.svg")" data-fallback-alt="Hình minh họa hành trình"/></div><div class="route-card-body"><small>Khởi hành từ @item.Origin</small><h3><span>@item.Destination</span> @await Html.PartialAsync("_Icon","arrow")</h3><div class="route-meta">@await Html.PartialAsync("_Icon","clock") Dự kiến @StopPresentation.Duration(item.DurationMinutes)</div><span class="route-cta">Xem lịch chuyến →</span></div></a></article>
}</div></section>
<section class="how-section panel"><div><h2>Cách đặt vé</h2><p>Thông tin rõ ràng từ chọn ghế đến nhận mã vé.</p><a class="text-action" asp-controller="Home" asp-action="Policy">Xem chính sách đặt & đổi trả →</a></div><ol class="how-list"><li><span aria-hidden="true">1</span><div><h3>Tìm & chọn chuyến</h3><p>Xem thời gian, giá mỗi ghế và số ghế còn khả dụng.</p></div></li><li><span aria-hidden="true">2</span><div><h3>Giữ ghế trong 5 phút</h3><p>Giữ ghế thành công, sau đó nhập thông tin hành khách trước hạn.</p></div></li><li><span aria-hidden="true">3</span><div><h3>Xác nhận & theo dõi vé</h3><p>Nhận mã vé trong tài khoản. Thanh toán bằng QR và bấm Hoàn tất để nhận vé.</p></div></li></ol></section>

<section class="panel contact-callout"><div><h2>Hỗ trợ đặt vé</h2><p>Gửi câu hỏi hoặc góp ý qua biểu mẫu liên hệ trong hệ thống.</p></div><a class="btn btn-primary" asp-controller="Contact" asp-action="Index">Liên hệ Bus Center →</a></section>
