@model RegisterForm
@{ViewData["Title"]="Một tài khoản, mọi hành trình";}
<section class="auth-layout"><aside class="auth-art"><span class="eyebrow">BUS CENTER · THUẬN TIỆN TỪNG HÀNH TRÌNH</span><h1>Một tài khoản, mọi hành trình</h1><p>Lưu vé và theo dõi thông tin đặt chỗ trong tài khoản của bạn.</p><figure class="hero-photo">@await Html.PartialAsync("_Photo",new PhotoDisplay(PhotoCatalog.CoachHero,true))</figure><div class="auth-benefit">Giữ chỗ 5 phút · Thanh toán QR</div></aside><div class="panel auth-form"><span class="eyebrow">ĐĂNG KÝ KHÁCH HÀNG</span><h2>Tạo tài khoản</h2><p>Lưu vé và theo dõi thông tin đặt chỗ trong tài khoản của bạn.</p><form asp-action="Register" method="post"><div asp-validation-summary="All" class="validation" role="alert"></div><div class="field"><label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name"/><span asp-validation-for="FullName"></span></div><div class="field"><label asp-for="Email"></label><input asp-for="Email" autocomplete="email"/><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="Password"></label><div class="password-control"><input asp-for="Password" autocomplete="new-password" minlength="@AppUser.MinimumPasswordLength" aria-describedby="register-password-hint" required/><button type="button" class="password-toggle" data-password-target="Password" aria-controls="Password" aria-pressed="false" aria-label="Hiện mật khẩu">Hiện</button></div><small id="register-password-hint">Mật khẩu cần ít nhất @AppUser.MinimumPasswordLength ký tự.</small><span asp-validation-for="Password"></span></div><div class="field"><label asp-for="ConfirmPassword"></label><div class="password-control"><input asp-for="ConfirmPassword" autocomplete="new-password"/><button type="button" class="password-toggle" data-password-target="ConfirmPassword" aria-controls="ConfirmPassword" aria-pressed="false" aria-label="Hiện mật khẩu">Hiện</button></div><span asp-validation-for="ConfirmPassword"></span></div><button class="btn btn-primary w-100">Tạo tài khoản →</button></form><p class="auth-footnote">Bạn đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p></div></section>