@model ProfileForm
@{ ViewData["Title"]="Thông tin cá nhân"; }
<section class="profile-page">
    <div class="page-heading">
        <h1>Thông tin cá nhân</h1>
        <p>Quản lý thông tin liên hệ và địa chỉ của bạn.</p>
    </div>
    <div class="policy-grid">
        <section class="panel" aria-labelledby="profile-account-title">
            <h2 id="profile-account-title">Tài khoản của bạn</h2>
            <dl class="summary">
                <div><dt>Tên đăng nhập</dt><dd>@Model.UserName</dd></div>
                <div><dt>Email</dt><dd>@Model.Email</dd></div>
                <div><dt>Vai trò</dt><dd>@Model.RoleLabel</dd></div>
                <div><dt>Trạng thái</dt><dd>@(Model.IsActive?"Hoạt động":"Ngừng hoạt động")</dd></div>
                <div><dt>Ngày tạo hồ sơ</dt><dd>@BusinessTime.Text(Model.CreatedUtc)</dd></div>
            </dl>
            <details>
                <summary>Mã người dùng</summary>
                <p style="overflow-wrap:anywhere">@Model.UserId</p>
            </details>
            <div class="actions">
                <a class="btn btn-outline-primary" asp-action="ChangePassword">Đổi mật khẩu</a>
            </div>
        </section>
        <section class="panel" aria-labelledby="profile-details-title">
            <h2 id="profile-details-title">Hồ sơ của bạn</h2>
            <form asp-action="Profile" method="post">
                <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
                <div class="form-grid">
                    <div class="field">
                        <label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name"/>
                        <span asp-validation-for="FullName"></span>
                    </div>
                    <div class="field">
                        <label asp-for="Phone"></label><input asp-for="Phone" type="tel" autocomplete="tel"/>
                        <span asp-validation-for="Phone"></span>
                    </div>
                    <div class="field">
                        <label asp-for="DateOfBirth"></label><input asp-for="DateOfBirth" type="date" asp-format="{0:yyyy-MM-dd}" autocomplete="bday"/>
                        <span asp-validation-for="DateOfBirth"></span>
                    </div>
                    <div class="field">
                        <label asp-for="ProvinceCode"></label>
                        <select asp-for="ProvinceCode" autocomplete="address-level1">
                            <option value="">Chọn tỉnh / thành phố</option>
                            @foreach(var province in ProvinceSearch.Provinces.OrderBy(p=>p.Value,System.StringComparer.Create(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"),true))){
                                <option value="@province.Key">@province.Value</option>
                            }
                        </select>
                        <span asp-validation-for="ProvinceCode"></span>
                    </div>
                </div>
                <div class="field">
                    <label asp-for="Address"></label><input asp-for="Address" autocomplete="street-address"/>
                    <span asp-validation-for="Address"></span>
                </div>
                <button class="btn btn-primary" type="submit">Lưu hồ sơ</button>
            </form>
        </section>
    </div>
</section>
