@model ChangePasswordForm
@{ ViewData["Title"] = "Đổi mật khẩu"; }
<section class="page-heading">
    <h1>Đổi mật khẩu</h1>
    <p>Sau khi đổi mật khẩu, bạn có thể tiếp tục làm việc trên thiết bị này.</p>
</section>
<section class="panel edit-panel">
    <form asp-action="ChangePassword" method="post">
        <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
        <fieldset class="form-fieldset">
            <legend>Mật khẩu đăng nhập</legend>
            <div class="field">
                <label asp-for="CurrentPassword"></label>
                <input asp-for="CurrentPassword" autocomplete="current-password" required/>
                <span asp-validation-for="CurrentPassword"></span>
            </div>
            <partial name="_NewPasswordFields" model="Model"/>
        </fieldset>
        <div class="form-savebar">
            <a class="btn btn-outline-secondary" asp-action="Profile">Về hồ sơ cá nhân</a>
            <button class="btn btn-primary" type="submit">Đổi mật khẩu</button>
        </div>
    </form>
</section>
