@model LoginForm
@{ViewData["Title"]="Chào mừng bạn trở lại";}
<section class="auth-layout"><aside class="auth-art"><span class="eyebrow">BUS CENTER · THUẬN TIỆN TỪNG HÀNH TRÌNH</span><h1>Chào mừng bạn trở lại</h1><p>Đăng nhập để tiếp tục hành trình và quản lý vé của bạn.</p><figure class="hero-photo">@await Html.PartialAsync("_Photo",new PhotoDisplay(PhotoCatalog.CoachHero,true))</figure><div class="auth-benefit">Giữ chỗ 5 phút · Thanh toán QR</div></aside><div class="panel auth-form"><span class="eyebrow">TÀI KHOẢN CỦA BẠN</span><h2>Đăng nhập</h2><p>Đăng nhập để tiếp tục hành trình và quản lý vé của bạn.</p><form asp-action="Login" method="post"><div asp-validation-summary="All" class="validation" role="alert"></div><input asp-for="ReturnUrl" type="hidden"/><div class="field"><label asp-for="Email"></label><input asp-for="Email" autocomplete="username"/><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="Password"></label><div class="password-control"><input asp-for="Password" autocomplete="current-password"/><button type="button" class="password-toggle" data-password-target="Password" aria-controls="Password" aria-pressed="false" aria-label="Hiện mật khẩu">Hiện</button></div><span asp-validation-for="Password"></span></div><button class="btn btn-primary w-100">Đăng nhập →</button></form><p class="auth-footnote">Bạn chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p></div></section>