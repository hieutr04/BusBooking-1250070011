@model List<ChangeRequest>
@{ViewData["Title"]="Yêu cầu đổi / trả";}
<partial name="_StaffNav"/><section class="page-heading operations-heading"><h1>Yêu cầu đổi / trả</h1><p class="screen-description">Tiếp nhận yêu cầu và xử lý theo chính sách đang công bố. Vé chỉ thay đổi hiệu lực sau giao dịch thành công.</p><p>Mở chi tiết để hủy hoặc chọn chuyến thay thế. Chỉ thay đổi hiệu lực vé sau khi giao dịch thành công.</p></section>
@foreach(var r in Model){<article class="panel request-row"><div><span class="pill">@(r.Status==RequestStatus.Pending?"Chờ xử lý":r.Status==RequestStatus.Approved?"Đã xử lý":"Từ chối")</span><h2>@r.Booking.Code · @(r.Kind==ChangeKind.Cancel?"Hủy vé":"Đổi vé")</h2><p>@r.Reason</p><small>@BusinessTime.Text(r.CreatedUtc)</small><p>@r.Resolution</p></div><div><a class="btn btn-primary" asp-controller="Bookings" asp-action="Details" asp-route-id="@r.BookingId">Chi tiết / xử lý →</a>@if(r.Status==RequestStatus.Pending){<form asp-action="Reject" method="post"><input name="id" value="@r.Id" type="hidden"/><label for="resolution-@r.Id">Lý do từ chối</label><input id="resolution-@r.Id" name="resolution" maxlength="500" required/><button class="btn btn-outline-danger btn-sm">Từ chối yêu cầu</button></form>}</div></article>}

@if(Model.Count==0){<section class="empty panel"><h2>Chưa có dữ liệu phù hợp</h2><p>Không tìm thấy bản ghi phù hợp.</p></section>}
