@model NewPasswordForm
@{
    var driverId = ViewData["DriverId"];
    var hasPassword = ViewData["HasPassword"] is true;
    ViewData["Title"] = hasPassword ? "Cấp lại mật khẩu tài xế" : "Đặt mật khẩu tài xế";
}
<partial name="_AdminNav"/>
<section class="page-heading">
    <h1>@ViewData["Title"]</h1>
    <p>@ViewData["DriverName"] · @ViewData["DriverEmail"]</p>
</section>
<a class="back-link" asp-action="DriverEdit" asp-route-id="@driverId">← Hồ sơ tài xế</a>
<section class="panel edit-panel">
    <p>@(hasPassword ? "Mật khẩu cũ và các phiên đăng nhập hiện tại sẽ hết hiệu lực." : "Tài xế có thể dùng mật khẩu mới để đăng nhập.")</p>
    <form asp-action="DriverPassword" asp-route-id="@driverId" method="post">
        <div asp-validation-summary="ModelOnly" class="validation" role="alert"></div>
        <fieldset class="form-fieldset">
            <legend>Mật khẩu đăng nhập</legend>
            <partial name="_NewPasswordFields" model="Model"/>
        </fieldset>
        <div class="form-savebar">
            <a class="btn btn-outline-secondary" asp-action="DriverEdit" asp-route-id="@driverId">Quay lại hồ sơ</a>
            <button class="btn btn-primary" type="submit">Lưu mật khẩu</button>
        </div>
    </form>
</section>
