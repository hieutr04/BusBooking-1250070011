@model List<AuditEntry>
@{ViewData["Title"]="Nhật ký tác nghiệp";}
<partial name="_AdminNav"/><section class="page-heading operations-heading"><h1>Nhật ký tác nghiệp</h1><p class="screen-description">Tra cứu những thay đổi đã ghi nhận trong quá trình vận hành. Hiển thị tối đa 200 bản ghi mới nhất.</p></section><div class="list-meta"><strong>@Model.Count bản ghi đang hiển thị</strong><span>Thời gian Việt Nam · UTC+7</span></div><div class="panel table-wrap"><table><thead><tr><th>Giờ Việt Nam</th><th>Người thực hiện</th><th>Thao tác</th><th>Đối tượng</th><th>Chi tiết</th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@BusinessTime.Text(a.CreatedUtc)</td><td><code>@AuditPresentation.Actor(a.ActorId)</code></td><td>@AuditPresentation.Action(a.Action)</td><td><code>@a.EntityId</code></td><td>@AuditPresentation.Detail(a)</td></tr>}</tbody></table></div>

@if(Model.Count==0){<section class="empty panel"><h2>Chưa có dữ liệu phù hợp</h2><p>Không tìm thấy bản ghi phù hợp.</p></section>}
