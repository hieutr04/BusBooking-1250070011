@model TripScheduleVm
@{ViewData["Title"]="Chuyến & phân công";}
<partial name="_AdminNav"/><div class="section-heading page-heading operations-heading"><div><span class="eyebrow">ĐIỀU HÀNH</span><h1>Chuyến xe & phân công</h1><p class="screen-description">Lịch khởi hành, giá vé và phân công. Mọi thao tác mở/đóng bán dùng chung quy tắc giao dịch.</p></div><div class="actions"><a class="btn btn-outline-primary" asp-action="TripBatch">Tạo lịch hàng loạt</a><a class="btn btn-primary" asp-action="TripEdit">+ Tạo chuyến</a></div></div><partial name="_TripScheduleFilter" model="Model"/><div class="panel table-wrap"><table><thead><tr><th>Chuyến / tuyến</th><th>Giờ Việt Nam</th><th>Xe / giá</th><th>Phân công</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var t in Model.Trips){<tr><td>#@t.Id<br/>@t.Route.Label</td><td>@BusinessTime.Text(t.DepartureUtc)<br/><small>Đến @BusinessTime.Text(t.ArrivalUtc)</small></td><td>@t.Vehicle.Plate<br/>@BusinessTime.Money(t.Fare)</td><td>TX chính: @(t.Driver?.FullName??"Chưa phân công")<br/>TX thứ hai: @(t.CoDriver?.FullName??"Chưa phân công")<br/><small>NV: @(t.Staff?.FullName??"Chưa phân công")</small></td><td>@BusinessTime.TripLabel(t.Status)<br/>@(t.SalesOpen?"Mở bán":"Đóng bán")</td><td><div class="table-actions"><a asp-action="TripEdit" asp-route-id="@t.Id">Sửa / phân công</a><a asp-action="TripStops" asp-route-id="@t.Id">Điểm đón / trả</a><a asp-controller="Staff" asp-action="Passengers" asp-route-id="@t.Id">Hành khách</a>@if(t.Status==TripStatus.Scheduled){<form asp-action="Sales" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" method="post"><input name="id" type="hidden" value="@t.Id"/><input name="open" type="hidden" value="@((!t.SalesOpen).ToString())"/><button class="btn-text" data-confirm="Thay đổi mở bán? Đóng bán sẽ nhả các hold chưa thành vé.">@(t.SalesOpen?"Đóng bán":"Mở bán")</button></form>}@if(t.Status is TripStatus.Scheduled or TripStatus.Boarding){<form asp-action="CancelTrip" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")" method="post"><input name="id" type="hidden" value="@t.Id"/><button class="btn-text text-danger" data-confirm="Hủy toàn bộ chuyến và vé còn hiệu lực? Khoản đã thanh toán sẽ chờ xử lý hoàn tiền.">Hủy chuyến</button></form>}</div></td></tr>}</tbody></table></div>

@if(Model.Total==0){<section class="empty panel"><h2>Không tìm thấy chuyến xe</h2><p>Hãy chọn ngày khác hoặc điều chỉnh bộ lọc.</p></section>}

<partial name="_TripSchedulePagination" model="Model"/>
