@model LayoutForm
@{ViewData["Title"]="Cấu hình sơ đồ ghế";}
<partial name="_AdminNav"/><section class="page-heading"><h1>Cấu hình sơ đồ ghế</h1></section><a class="back-link" asp-action="Layouts">← Quay lại danh sách</a><section class="panel edit-panel"><form asp-action="LayoutEdit" method="post"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="validation"></div><fieldset class="form-fieldset"><legend>Cấu trúc sơ đồ ghế</legend><div class="form-grid"><div class="field"><label asp-for="Name"></label><input asp-for="Name"/><span asp-validation-for="Name"></span></div><div class="field"><label asp-for="Rows"></label><input asp-for="Rows"/><span asp-validation-for="Rows"></span></div><div class="field"><label asp-for="Columns"></label><input asp-for="Columns"/><span asp-validation-for="Columns"></span></div><div class="field"><label asp-for="Floors"></label><input asp-for="Floors"/><span asp-validation-for="Floors"></span></div><div class="field"><label asp-for="IsActive"></label><input asp-for="IsActive"/><span asp-validation-for="IsActive"></span></div></div></fieldset><section class="layout-preview-panel" aria-labelledby="preview-title"><h2 id="preview-title">Xem trước cấu hình đang nhập</h2><p>Xem trước sơ đồ. Bấm Lưu để áp dụng cấu hình.</p><div id="layout-preview" aria-live="polite"></div></section><p class="notice">Cấu trúc hàng/cột/tầng sinh ghế vật lý tự động, mã A01… (tầng 1), B01… (tầng 2). Sơ đồ 4 cột hiển thị 2 + lối đi + 2. Sơ đồ 3 cột tách các dãy bằng lối đi; lối đi không sinh ghế. Sơ đồ đã gắn xe không thay cấu trúc.</p><div class="form-savebar"><a class="btn btn-outline-secondary" asp-action="Layouts">Quay lại danh sách</a><button class="btn btn-primary">Lưu thay đổi</button></div></form></section>