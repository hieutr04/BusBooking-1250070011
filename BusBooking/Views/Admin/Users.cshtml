@model List<AppUser>
@{
    ViewData["Title"]="Tài khoản & vai trò";
    var roles=(Dictionary<string,string>)ViewBag.RoleMap;
}
<partial name="_AdminNav"/>
<section class="page-heading operations-heading">
    <h1>Tài khoản người dùng</h1>
    <p class="screen-description">Tra cứu hồ sơ, tên đăng nhập, vai trò và trạng thái tài khoản.</p>
</section>
<div class="list-meta"><strong>@Model.Count tài khoản</strong><span>Thời gian Việt Nam · UTC+7</span></div>
<div class="panel table-wrap" role="region" aria-label="Danh sách tài khoản" tabindex="0">
    <table>
        <thead><tr><th scope="col">Hồ sơ</th><th scope="col">Thông tin đăng nhập</th><th scope="col">Vai trò</th><th scope="col">Trạng thái</th><th scope="col">Cập nhật quyền</th></tr></thead>
        <tbody>
        @foreach(var user in Model){
            <tr>
                <td>
                    <strong>@user.FullName</strong>
                    <small>@(user.PhoneNumber??"—") · @(user.DateOfBirth?.ToString("dd/MM/yyyy")??"—")</small>
                    <small>@user.Address</small>
                    @if(user.ProvinceCode is not null&&ProvinceSearch.Provinces.TryGetValue(user.ProvinceCode,out var province)){
                        <small>@province · Mã tỉnh @user.ProvinceCode</small>
                    }
                </td>
                <td>
                    <strong>@user.UserName</strong><small>@user.Email</small>
                    <small>@(user.PasswordHash is null?"Chưa cấp mật khẩu":"Đã thiết lập mật khẩu")</small>
                </td>
                <td>@string.Join(", ",roles[user.Id].Split(", ").Select(Roles.Label))</td>
                <td>@(user.IsActive?"Hoạt động":"Ngừng hoạt động")</td>
                <td>
                    <form asp-action="UserRole" method="post" class="inline-form">
                        <input name="UserId" value="@user.Id" type="hidden"/>
                        <label class="visually-hidden" for="role-@user.Id">Vai trò cho @user.Email</label>
                        <select name="Role" id="role-@user.Id">
                            @foreach(var role in Roles.All){<option value="@role" selected="@(roles[user.Id]==role)">@Roles.Label(role)</option>}
                        </select>
                        <label><input type="checkbox" name="IsActive" value="true" checked="@user.IsActive"/>Hoạt động</label>
                        <button class="btn btn-outline-primary btn-sm" data-confirm="Xác nhận cập nhật vai trò và trạng thái tài khoản này?">Lưu</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
@if(Model.Count==0){<section class="empty panel"><h2>Chưa có tài khoản</h2></section>}
