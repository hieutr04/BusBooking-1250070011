@model DriverForm
@{
    var creating = string.IsNullOrEmpty(Model.Id);
    ViewData["Title"] = creating ? "Thêm tài xế" : "Chỉnh sửa tài xế";
}
<partial name="_AdminNav"/>
<section class="page-heading"><h1>@ViewData["Title"]</h1></section>
<a class="back-link" asp-action="Drivers">← Danh sách tài xế</a>
<section class="panel edit-panel">
    <form asp-action="DriverEdit" method="post">
        <input asp-for="Id" type="hidden"/>
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <fieldset class="form-fieldset">
            <legend>Hồ sơ tài xế</legend>
            <div class="form-grid">
                <div class="field"><label asp-for="FullName"></label><input asp-for="FullName"/><span asp-validation-for="FullName"></span></div>
                <div class="field"><label asp-for="Email"></label><input asp-for="Email"/><span asp-validation-for="Email"></span></div>
                <div class="field"><label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber" type="tel"/><span asp-validation-for="PhoneNumber"></span></div>
                <div class="field"><label asp-for="DateOfBirth"></label><input asp-for="DateOfBirth" type="date" asp-format="{0:yyyy-MM-dd}"/><span asp-validation-for="DateOfBirth"></span></div>
                <div class="field">
                    <label asp-for="IsActive"></label>
                    <select asp-for="IsActive"><option value="true">Hoạt động</option><option value="false">Ngừng hoạt động</option></select>
                    <span asp-validation-for="IsActive"></span>
                </div>
                @if (creating)
                {
                    <div class="field">
                        <label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" required minlength="@AppUser.MinimumPasswordLength"/>
                        <span asp-validation-for="Password"></span>
                    </div>
                }
            </div>
        </fieldset>
        <div class="form-savebar">
            <a class="btn btn-outline-secondary" asp-action="Drivers">Quay lại danh sách</a>
            <button class="btn btn-primary" type="submit">@(creating ? "Thêm tài xế" : "Lưu thay đổi")</button>
        </div>
    </form>
</section>
@if (!creating)
{
    <section class="panel edit-panel">
        <h2>Mật khẩu đăng nhập</h2>
        <p>Đặt mật khẩu lần đầu hoặc cấp lại mật khẩu cho tài xế này.</p>
        <a class="btn btn-outline-primary" asp-action="DriverPassword" asp-route-id="@Model.Id">Đặt / cấp lại mật khẩu</a>
    </section>
}
