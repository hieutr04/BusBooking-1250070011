@model TripForm
@{ViewData["Title"]="Chuyến xe & phân công";}
<partial name="_AdminNav"/><section class="page-heading"><h1>Chuyến xe & phân công</h1></section><a class="back-link" asp-action="Trips">← Quay lại danh sách</a><section class="panel edit-panel"><form asp-action="TripEdit" method="post"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="validation"></div><fieldset class="form-fieldset"><legend>Hành trình, giá và phân công</legend><div class="form-grid"><div class="field"><label asp-for="BusRouteId"></label><select asp-for="BusRouteId" asp-items="ViewBag.Routes"><option value="">Chọn giá trị</option></select><span asp-validation-for="BusRouteId"></span></div><div class="field"><label asp-for="VehicleId"></label><select asp-for="VehicleId" asp-items="ViewBag.Vehicles"><option value="">Chọn giá trị</option></select><span asp-validation-for="VehicleId"></span></div><div class="field"><label asp-for="DepartureLocal"></label><input asp-for="DepartureLocal" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}"/><span asp-validation-for="DepartureLocal"></span></div><div class="field"><label asp-for="ArrivalLocal"></label><input asp-for="ArrivalLocal" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}"/><span asp-validation-for="ArrivalLocal"></span></div><div class="field"><label asp-for="Fare"></label><input name="Fare" id="Fare" value="@Model.Fare.ToString("0", System.Globalization.CultureInfo.InvariantCulture)" type="number" min="0" max="10000000" step="1"/><span asp-validation-for="Fare"></span></div><div class="field"><label asp-for="DriverId"></label><select asp-for="DriverId" asp-items="ViewBag.Drivers"><option value="">Chọn giá trị</option></select><span asp-validation-for="DriverId"></span></div><div class="field"><label asp-for="CoDriverId"></label><select asp-for="CoDriverId" asp-items="ViewBag.Drivers"><option value="">Chưa phân công</option></select><span asp-validation-for="CoDriverId"></span></div><div class="field"><label asp-for="StaffId"></label><select asp-for="StaffId" asp-items="ViewBag.Staffs"><option value="">Chọn giá trị</option></select><span asp-validation-for="StaffId"></span></div></div></fieldset><p class="notice">Giờ nhập theo Việt Nam. Kiểm trùng lịch xe/tài xế/nhân viên bằng khoảng [khởi hành, đến dự kiến), khoảng đệm mặc định 0 phút. Khi chuyến có lịch sử hold, khóa xe/tuyến/giờ/giá; vẫn cho sửa phân công hợp lệ.</p><div class="form-savebar"><a class="btn btn-outline-secondary" asp-action="Trips">Quay lại danh sách</a><button class="btn btn-primary">Lưu thay đổi</button></div></form></section>