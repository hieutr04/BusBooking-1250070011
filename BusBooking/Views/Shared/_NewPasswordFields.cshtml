@model NewPasswordForm
<div class="form-grid">
    <div class="field">
        <label asp-for="NewPassword"></label>
        <input asp-for="NewPassword" autocomplete="new-password" aria-describedby="new-password-hint" required minlength="@AppUser.MinimumPasswordLength"/>
        <small id="new-password-hint">Mật khẩu cần ít nhất @AppUser.MinimumPasswordLength ký tự.</small>
        <span asp-validation-for="NewPassword"></span>
    </div>
    <div class="field">
        <label asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" required/>
        <span asp-validation-for="ConfirmPassword"></span>
    </div>
</div>
