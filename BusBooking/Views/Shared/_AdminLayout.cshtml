@inject Microsoft.Extensions.Options.IOptions<ContactOptions> FooterContact
@{var role=User.IsInRole("Admin")?"Quản trị viên":User.IsInRole("Staff")?"Nhân viên":"Tài xế";var home=User.IsInRole("Admin")?"Admin":User.IsInRole("Staff")?"Staff":"Driver";}
<!doctype html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] · Bus Center Điều hành</title><link rel="icon" href="~/images/favicon.svg" type="image/svg+xml"/>
<link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/ui.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/admin.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/photos-contact.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/booking.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/busgo.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/buscenter.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/transit.css" asp-append-version="true"/>
@if(home=="Admin"){
<link rel="stylesheet" href="~/css/admin-overview.css" asp-append-version="true"/>
}
</head>
<body class="workspace @(home=="Admin"?"admin-workspace":null)"><a class="skip-link" href="#main">Đến nội dung</a>
<aside id="workspace-sidebar" class="workspace-side offcanvas-lg offcanvas-start" tabindex="-1" aria-labelledby="workspace-nav-title"><partial name="_WorkspaceSidebar"/></aside>
<div class="workspace-body"><header class="workspace-header"><div class="workspace-header-left"><button class="workspace-menu d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#workspace-sidebar" aria-controls="workspace-sidebar" aria-expanded="false" aria-label="Mở điều hướng">☰</button><div><nav class="workspace-crumb" aria-label="Đường dẫn"><a asp-controller="@home" asp-action="Index">Điều hành</a><span aria-hidden="true">/</span><span>@ViewData["Title"]</span></nav><strong>@ViewData["Title"]</strong></div></div>
<div class="workspace-header-actions"><a class="view-site" asp-controller="Home" asp-action="Index">@await Html.PartialAsync("_Icon","external")<span>Xem website</span></a><details class="account-menu"><summary><span class="account-avatar" aria-hidden="true">@await Html.PartialAsync("_Icon","user")</span><span>@role<small>@User.Identity?.Name</small></span><span aria-hidden="true">⌄</span></summary><div class="account-popover"><a asp-controller="Account" asp-action="Profile">Hồ sơ tài khoản</a><a asp-controller="Account" asp-action="ChangePassword">Đổi mật khẩu</a><form asp-controller="Account" asp-action="Logout" method="post"><button type="submit">Đăng xuất</button></form></div></details></div></header>
<noscript><nav class="nojs-nav" aria-label="Điều hướng khi JavaScript tắt"><a asp-controller="@home" asp-action="Index">Điều hành</a><a asp-controller="Home" asp-action="Index">Xem website</a><a asp-controller="Account" asp-action="Profile">Hồ sơ</a></nav></noscript>
<main id="main" class="workspace-main">@if(TempData["Notice"] is string notice){<div class="notice" role="status">@await Html.PartialAsync("_Icon","check") @notice</div>}@RenderBody()</main>
<footer class="workspace-footer"><span>Bus Center · Điều hành · <a asp-controller="Photos" asp-action="Index">Nguồn ảnh</a></span><partial name="_SupportChannels" model="FooterContact.Value"/></footer></div>
<partial name="_TransitDialog"/>
<script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script><script src="~/js/seat-layout.js" asp-append-version="true"></script><script src="~/js/site.js" asp-append-version="true"></script><script src="~/js/admin.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)
</body></html>
