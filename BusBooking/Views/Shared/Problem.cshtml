@model ProblemVm
@{ViewData["Title"]="Thông báo "+Model.Status;var heading=Model.Status switch {400=>"Kiểm tra lại thông tin",403=>"Bạn chưa có quyền truy cập",404=>"Không tìm thấy nội dung",409=>"Dữ liệu vừa thay đổi",503=>"Kết nối dữ liệu chưa sẵn sàng",_=>"Chưa thể hoàn tất yêu cầu"};}
<section class="problem panel"><span class="eyebrow">THÔNG BÁO HỆ THỐNG</span><div class="problem-code">@Model.Status</div><h1>@heading</h1><p>@Model.Message</p><div class="problem-request"><span>Mã yêu cầu</span><code>@Model.RequestId</code></div><div class="actions"><a class="btn btn-primary" asp-controller="Home" asp-action="Index">Về trang chủ</a><a class="btn btn-outline-secondary" asp-controller="Trips" asp-action="Index">Tìm chuyến xe</a></div><p class="small-note">Nếu cần hỗ trợ kiểm tra lỗi, hãy cung cấp mã yêu cầu ở trên.</p></section>
