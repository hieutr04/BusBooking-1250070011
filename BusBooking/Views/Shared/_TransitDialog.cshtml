<dialog id="transit-confirm" class="transit-dialog" aria-labelledby="transit-dialog-title" aria-describedby="transit-dialog-message">
    <form method="dialog">
        <span class="eyebrow">BUS CENTER</span>
        <h2 id="transit-dialog-title">Xác nhận thao tác</h2>
        <p id="transit-dialog-message"></p>
        <div class="transit-dialog-actions">
            <button type="submit" value="cancel" class="btn btn-outline-secondary" autofocus>Quay lại</button>
            <button type="submit" value="accept" class="btn btn-primary" id="transit-dialog-accept">Xác nhận</button>
        </div>
    </form>
</dialog>
