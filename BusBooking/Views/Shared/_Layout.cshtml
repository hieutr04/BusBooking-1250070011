<!doctype html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>@ViewData["Title"] · Bus Center</title><link rel="icon" href="~/images/favicon.svg" type="image/svg+xml"/><link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/ui.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/photos-contact.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/booking.css" asp-append-version="true"/><meta name="description" content="Bus Center — tìm chuyến xe, chọn ghế và quản lý vé trực tuyến."/><link rel="stylesheet" href="~/css/busgo.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/buscenter.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/transit.css" asp-append-version="true"/></head>
<body class="public-site"><a class="skip-link" href="#main">Đến nội dung</a>
<header class="site-header"><div class="shell header-inner"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-icon"><img src="~/images/buscenter-mark.svg" width="42" height="42" alt="" aria-hidden="true"/></span><span class="brand-wordmark">Bus <span class="brand-accent">Center</span><small>THUẬN TIỆN TỪNG HÀNH TRÌNH</small></span></a>
<button class="nav-toggle" type="button" aria-controls="mainnav" aria-expanded="false" aria-label="Mở menu"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button><nav id="mainnav" aria-label="Điều hướng chính"><a asp-controller="Home" asp-action="Index" data-nav="home">Trang chủ</a><a asp-controller="Trips" asp-action="Index" data-nav="trips">Tìm chuyến</a><a asp-controller="Home" asp-action="Policy" data-nav="policy">Chính sách đổi / trả</a><a asp-controller="Contact" asp-action="Index" data-nav="contact">Liên hệ</a>
@if(User.IsInRole("Customer")||User.IsInRole("Staff")||User.IsInRole("Admin")){<a asp-controller="Bookings" asp-action="Index" data-nav="bookings">Vé của tôi</a>}
@if(User.IsInRole("Admin")){<a class="nav-workspace" asp-controller="Admin" asp-action="Index">Khu quản trị ↗</a>}
else if(User.IsInRole("Staff")){<a class="nav-workspace" asp-controller="Staff" asp-action="Index">Phòng vé ↗</a>}
else if(User.IsInRole("Driver")){<a class="nav-workspace" asp-controller="Driver" asp-action="Index">Lịch tài xế ↗</a>}
@if(User.Identity?.IsAuthenticated==true){<details class="account-menu"><summary>@await Html.PartialAsync("_Icon","user")<span>Tài khoản</span><span aria-hidden="true">⌄</span></summary><div class="account-popover"><span class="account-email">@User.Identity.Name</span><a asp-controller="Account" asp-action="Profile">Hồ sơ cá nhân</a><a asp-controller="Account" asp-action="ChangePassword">Đổi mật khẩu</a><form asp-controller="Account" asp-action="Logout" method="post"><button type="submit">Đăng xuất</button></form></div></details>}
else{<a class="login-link" asp-controller="Account" asp-action="Login">Đăng nhập</a><a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Đăng ký</a>}
</nav></div></header><main id="main" class="shell main-content">@if(TempData["Notice"] is string notice){<div class="notice" role="status">@await Html.PartialAsync("_Icon","check") @notice</div>}@RenderBody()</main>
<partial name="_SiteFooter"/>
<partial name="_TransitDialog"/>
<script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script><script src="~/js/seat-layout.js" asp-append-version="true"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
